---
import Media from '@/components/Media.astro';
import { site } from '@/data/site';
---

<section id="inicio" class="hero" aria-labelledby="hero-title" data-hero>
  <div class="page-shell">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="section-label">{site.name} · {site.city}</span>

        <h1
          id="hero-title"
          class="hero-title"
          aria-label="Tu estilo está en los detalles."
          data-hero-title
        >
          <span class="hero-line">
            <span class="hero-line__inner">Tu estilo</span>
          </span>
          <span class="hero-line">
            <span class="hero-line__inner">está en los</span>
          </span>
          <span class="hero-line">
            <span class="hero-line__inner"><em>detalles</em>.</span>
          </span>
        </h1>

        <p class="body-lg hero-sub" data-hero-sub>
          Manicura, esmaltado semipermanente y uñas acrílicas en Pamplona. Un ritmo
          pausado, luz natural y atención al detalle.
        </p>

        <div class="hero-actions" data-hero-actions>
          <a class="button" href={site.phone.href}>Consultar disponibilidad</a>
          <a class="button button--ghost" href="#servicios">Ver servicios</a>
        </div>

        <p class="hero-note" data-reveal>
          <span>Confirmación por teléfono o Instagram.</span>
        </p>

        <div class="hero-meta" data-reveal>
          <div>
            <span class="hero-meta__label">Servicios</span>
            <span class="hero-meta__value">Manicura<br />Acrílicas</span>
          </div>
          <div>
            <span class="hero-meta__label">Estudio</span>
            <span class="hero-meta__value">{site.city}<br />{site.region}</span>
          </div>
          <div>
            <span class="hero-meta__label">Contacto</span>
            <span class="hero-meta__value">Teléfono<br />Instagram</span>
          </div>
        </div>

        <a class="scroll-cue" href="#manifiesto">
          <span class="scroll-cue__line" aria-hidden="true"></span>
          Seguir leyendo
        </a>
      </div>

      <div class="hero-visual" data-hero-visual>
        <span class="hero-side-note" aria-hidden="true">MUA · Estética · Pamplona</span>
        <div class="hero-frame" aria-hidden="true"></div>
        <div class="hero-collage">
          <Media
            slot="hero-desktop"
            class="hero-visual__media hero-visual__media--main hero-visual__media--desktop"
            fluid
            eager
          />
          <Media
            slot="hero-mobile"
            class="hero-visual__media hero-visual__media--main hero-visual__media--mobile"
            fluid
            eager
          />
          <Media
            slot="hero-fachada"
            class="hero-visual__media hero-visual__media--facade"
            fluid
          />
          <div class="hero-rail">
            <div class="hero-rail__track">
              <div class="hero-rail__set">
                <Media
                  slot="hero-fachada"
                  class="hero-visual__media hero-rail__media"
                  fluid
                />
                <Media
                  slot="hero-detalle"
                  class="hero-visual__media hero-rail__media"
                  fluid
                />
                <Media
                  slot="hero-interior-01"
                  class="hero-visual__media hero-rail__media hero-rail__media--tall"
                  fluid
                />
              </div>
              <div class="hero-rail__set" aria-hidden="true">
                <Media
                  slot="hero-fachada"
                  class="hero-visual__media hero-rail__media"
                  fluid
                  eager
                  reveal={false}
                />
                <Media
                  slot="hero-detalle"
                  class="hero-visual__media hero-rail__media"
                  fluid
                  eager
                  reveal={false}
                />
                <Media
                  slot="hero-interior-01"
                  class="hero-visual__media hero-rail__media hero-rail__media--tall"
                  fluid
                  eager
                  reveal={false}
                />
              </div>
            </div>
          </div>
          <Media
            slot="hero-interior-02"
            class="hero-visual__media hero-visual__media--tile-one"
            fluid
          />
          <Media
            slot="hero-interior-03"
            class="hero-visual__media hero-visual__media--tile-two"
            fluid
          />
        </div>
        <p class="hero-visual__note">Imágenes ilustrativas</p>
      </div>
    </div>
  </div>
</section>
