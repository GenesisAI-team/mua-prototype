---
import Media from '@/components/Media.astro';
import { additionalServices, services } from '@/data/content';

const additionalServicesCopy = additionalServices
  .join(', ')
  .toLowerCase()
  .replace(/, ([^,]+)$/, ' y $1');
---

<section id="servicios" class="section services" aria-labelledby="services-title">
  <div class="page-shell services-grid">
    <div class="services-intro" data-services-intro>
      <span class="section-label">Servicios</span>
      <h2 id="services-title" class="services-title">Dos formas de cuidar tus manos.</h2>
      <p class="body-lg services-copy">
        Manicura y esmaltado semipermanente para un acabado cuidado; uñas acrílicas
        y extensiones para trabajar forma y longitud.
      </p>
      <p class="body-sm" style="margin-top: 1rem; max-width: 31rem;">
        También ofrecemos {additionalServicesCopy}. Consúltanos por teléfono o
        Instagram para confirmar disponibilidad.
      </p>
      <div class="services-progress" aria-hidden="true">
        <span class="services-progress__fill" data-service-progress></span>
      </div>
    </div>

    <div class="services-list">
      {services.map((service, index) => (
        <article class="service-card" data-service-card data-reveal>
          <Media
            slot={service.imageSlot}
            class:list={[
              'service-card__media',
              service.id === 'acrilicas' ? 'service-card__media--portrait' : '',
            ]}
          />
          <div class="service-card__body">
            <span class="section-label">
              {String(index + 1).padStart(2, '0')} · Servicio
            </span>
            <h3 class="service-card__title">{service.title}</h3>
            <p class="body-lg service-card__description">{service.description}</p>
            <p class="service-card__detail">{service.detail}</p>
            <a class="text-link" href="#contacto">Consultar disponibilidad</a>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="page-shell services-cta">
    <p class="body-lg" style="max-width: 28rem;">
      ¿No sabes qué elegir? Cuéntanoslo y te orientamos.
    </p>
    <a class="button button--ghost" href="#contacto">Hablar con MUA</a>
  </div>
</section>
