---
import Media from '@/components/Media.astro';
import { gallery } from '@/data/content';
---

<section id="galeria" class="section gallery" aria-labelledby="gallery-title">
  <div class="page-shell">
    <div class="section-head">
      <div>
        <span class="section-label">Galería</span>
        <h2 id="gallery-title" class="section-head__title" style="margin-top: 1.5rem;">
          Textura, luz y detalle.
        </h2>
      </div>
      <div class="section-head__copy">
        <p class="body-lg">
          La dirección visual está definida. Las fotografías definitivas se
          incorporarán con autorización; hasta entonces, estos espacios muestran el
          ritmo y la composición de la galería.
        </p>
        <span class="provisional-tag" style="margin-top: 1rem;">Imágenes pendientes</span>
      </div>
    </div>

    <div class="gallery-grid">
      {gallery.map((item) => (
        <div class:list={['gallery-item', `gallery-item--${item.position}`]} data-reveal>
          <figure class="gallery-figure">
            <Media slot={item.slot} />
            <figcaption class="gallery-caption">
              <span>{item.caption}</span>
              <span>Pendiente</span>
            </figcaption>
          </figure>
        </div>
      ))}
    </div>
  </div>
</section>
