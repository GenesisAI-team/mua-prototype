---
import Media from '@/components/Media.astro';
import { gallery } from '@/data/content';

const standardGallery = gallery.filter((item) => item.position !== 'cluster');
const clusterGallery = gallery.filter((item) => item.position === 'cluster');
---

<section id="galeria" class="section gallery" aria-labelledby="gallery-title">
  <div class="page-shell">
    <div class="section-head">
      <div>
        <span class="section-label">Galería</span>
        <h2 id="gallery-title" class="section-head__title" style="margin-top: 1.5rem;">
          Textura, luz y detalle.
        </h2>
      </div>
      <div class="section-head__copy">
        <p class="body-lg">
          Una selección de detalles, color y ambiente del estudio. Las imágenes son
          recreaciones visuales ilustrativas.
        </p>
        <span class="provisional-tag" style="margin-top: 1rem;">Imágenes ilustrativas</span>
      </div>
    </div>

    <div class="gallery-grid">
      {standardGallery.map((item) => (
        <div
          class:list={['gallery-item', `gallery-item--${item.position}`]}
          data-slot={item.slot}
          data-reveal
        >
          <figure class="gallery-figure">
            <Media slot={item.slot} />
            <figcaption class="gallery-caption">
              <span>{item.caption}</span>
              <span>Ilustrativa</span>
            </figcaption>
          </figure>
        </div>
      ))}

      <div class="gallery-cluster">
        {clusterGallery.map((item) => (
          <div class="gallery-item gallery-item--cluster" data-slot={item.slot} data-reveal>
            <figure class="gallery-figure">
              <Media slot={item.slot} fluid />
              <figcaption class="gallery-caption">
                <span>{item.caption}</span>
                <span>Ilustrativa</span>
              </figcaption>
            </figure>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
