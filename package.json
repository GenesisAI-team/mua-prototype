{
  "name": "mua-estetica-prototype",
  "version": "1.0.0",
  "description": "Prototipo no oficial de la nueva web de MUA Estética (Pamplona). Astro + Tailwind 4 + GSAP/Lenis.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
